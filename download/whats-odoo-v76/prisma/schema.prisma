generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model OdooConfig {
  id        String   @id @default(cuid())
  url       String
  db        String
  username  String
  password  String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model WhatsAppSession {
  id        String   @id @default(cuid())
  sessionId String   @unique
  phone     String?
  name      String?
  pushName  String?
  avatarUrl String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Conversation {
  id             String   @id @default(cuid())
  jid            String   @unique
  contactName    String?
  contactPhone   String?
  pushName       String?
  avatarUrl      String?
  lastMessage    String?
  lastMessageAt  DateTime?
  unreadCount    Int      @default(0)
  odooPartnerId  Int?
  odooLeadId     Int?
  odooSaleId     Int?
  odooProjectId  Int?
  odooTaskId     Int?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  messages       Message[]
}

model Message {
  id             String   @id @default(cuid())
  conversationId String
  whatsappId     String?
  fromMe         Boolean
  textContent    String?
  mediaType      String?
  mediaUrl       String?
  mediaBase64    String?
  fileName       String?
  mimeType       String?
  timestamp      DateTime
  status         String   @default("delivered")
  syncedToOdoo   Boolean  @default(false)
  odooMailId     Int?
  createdAt      DateTime @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@index([timestamp])
}

model OdooSyncLog {
  id          String   @id @default(cuid())
  model       String
  recordId    Int
  action      String
  status      String
  message     String?
  payload     String?
  createdAt   DateTime @default(now())

  @@index([model])
  @@index([createdAt])
}

model AppSetting {
  id    String @id @default(cuid())
  key   String @unique
  value String
}
