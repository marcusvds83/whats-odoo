# WhatsApp-Odoo Middleware - Environment Variables

# ============================================================
# LOCAL DESENVOLVIMENTO
# ============================================================
DATABASE_URL=file:./dev.db
NODE_ENV=development
ODOO_SERVICE_URL=http://localhost:3002
PORT=3000

# ============================================================
# RENDER PRODUÇÃO (preencha no painel do Render)
# ============================================================
# DATABASE_URL=file:/opt/render/project/src/data/whats-odoo.db
# NODE_ENV=production
# PORT=10000
# HOSTNAME=0.0.0.0
# ODOO_SERVICE_URL=http://localhost:3002
# DATA_DIR=/opt/render/project/src/data

# ============================================================
# v7.25: ADMIN_SETUP_TOKEN — token para recuperação de admin
# ============================================================
# Se o login do admin quebrar (senha esquecida, role errada, conta
# desativada), você pode recuperar via /api/auth/setup-admin sem
# acesso direto ao banco.
#
# 1. Defina esta variável no Render com uma string longa e aleatória
#    (ex: openssl rand -hex 32)
# 2. Faça um POST para /api/auth/setup-admin com body:
#    { "setupToken": "<token>", "email": "admin@x.com",
#      "password": "novaSenha123", "name": "Admin" }
# 3. Se o usuário existir → vira admin + senha redefinida.
#    Se não existir → cria um novo admin.
# 4. Após recuperar, REMOVA a variável do Render (opcional, mas recomendado).
# ADMIN_SETUP_TOKEN=cole_uma_string_longa_e_aleatoria_aqui

